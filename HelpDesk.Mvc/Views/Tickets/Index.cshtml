@model List<TicketViewModel>
@{
    ViewData["Title"] = "All Tickets";
}

<h1>All Tickets</h1>

<p><a class="btn btn-primary" asp-controller="Tickets" asp-action="Create">+ Raise New Ticket</a></p>

@if (Model == null || Model.Count == 0)
{
    <p>No tickets found.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Raised By</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.Priority</td>
                <td>
                    <span class="badge @(ticket.Status == "Open" ? "badge-open" : ticket.Status == "In Progress" ? "badge-in-progress" : "badge-closed")">
                        @ticket.Status
                    </span>
                </td>
                <td>@ticket.RaisedBy</td>
                <td>@ticket.CreatedDate.ToString("dd-MMM-yyyy")</td>
                <td>
                    <a class="btn btn-secondary" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id">View</a>
                    <a class="btn btn-primary" asp-controller="Tickets" asp-action="Edit" asp-route-id="@ticket.Id">Edit</a>
                    <a class="btn btn-danger" asp-controller="Tickets" asp-action="Delete" asp-route-id="@ticket.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
